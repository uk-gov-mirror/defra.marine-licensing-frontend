<figure class="govuk-!-margin-0 govuk-!-margin-bottom-6" data-testid="app-site-notice-qr-code">
  <div role="img" aria-label="QR code linking to the public details page for this application" data-testid="app-site-notice-qr-code-image">
    {{- params.svg | safe -}}
  </div>
  <figcaption class="govuk-body" data-testid="app-site-notice-qr-code-caption">
    Scan the QR code or visit <a class="govuk-link" href="{{ params.url }}">{{ params.url }}</a>
  </figcaption>
</figure>
