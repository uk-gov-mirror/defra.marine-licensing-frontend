{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "radio-page/macro.njk" import appRadioPage %}

{% block beforeContent %}
{{ super() }}
<nav>
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
</nav>
{% endblock %}
{% block content %}

  <div style="background: #f3f2f1; padding: 20px; border: 2px solid #d4351c; font-family: monospace; font-size: 14px; max-width: 100%; overflow-wrap: break-word; word-wrap: break-word;">
    <p style="margin: 0 0 10px 0; overflow-wrap: break-word; word-wrap: break-word;">Site Index = {{ debugInfo.siteIndex }}, Site Number = {{ debugInfo.siteNumber }}, queryParams: {{ debugInfo.queryParams }}</p>
  </div>

  {{ appRadioPage({
      name: "sameActivityDates",
      errorSummary: errorSummary,
      errors: errors,
      heading: "Are the activity dates the same for every site?",
      isPageHeading: true,
      value: payload.sameActivityDates,
      errorMessage: errors['sameActivityDates'],
      projectName: projectName,
      items: [
        {
          value: "yes",
          text: "Yes, the dates are the same for every site",
          hint: {
            text: "You'll only need to enter the dates once"
          }
        },
        {
          value: "no",
          text: "No, at least one site has different dates",
          hint: {
            text: "You'll need to enter dates for each site"
          }
        }
      ],
      csrfToken: csrfToken,
      cancelLink: cancelLink
    })
  }}

{% endblock %}
