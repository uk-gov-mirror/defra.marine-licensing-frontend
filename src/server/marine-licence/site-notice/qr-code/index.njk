{% extends 'layouts/page.njk' %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "marine-licence/site-notice-qr-code/macro.njk" import appMarineLicenceSiteNoticeQrCode %}

{% block pageTitle %}{% if errorSummary %}Error: {% endif %}{{ pageTitle }}{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({ titleText: "There is a problem", errorList: errorSummary }) }}
      {% endif %}

      <h1 class="govuk-heading-l">{{ heading }}</h1>

      <form method="GET" novalidate>
        {{ govukInput({
          label: { text: "Base URL" },
          hint: { text: "The APP_BASE_URL for the environment, for example https://marine-licensing-frontend.test.cdp-int.defra.cloud" },
          id: "baseUrl",
          name: "baseUrl",
          type: "url",
          spellcheck: false,
          value: payload.baseUrl,
          errorMessage: errors.baseUrl if errors
        }) }}

        {{ govukInput({
          label: { text: "Marine licence ID" },
          hint: { text: "For example 6a7c4c11726ee5b252f27321" },
          id: "marineLicenceId",
          name: "marineLicenceId",
          spellcheck: false,
          value: payload.marineLicenceId,
          errorMessage: errors.marineLicenceId if errors
        }) }}

        {{ govukInput({
          label: { text: "Size" },
          hint: { text: "Width and height in pixels, between 60 and 1000" },
          id: "size",
          name: "size",
          inputmode: "numeric",
          classes: "govuk-input--width-4",
          suffix: { text: "px" },
          value: payload.size,
          errorMessage: errors.size if errors
        }) }}

        {{ govukButton({ text: "Generate QR code" }) }}
      </form>
    </div>
  </div>

  {% if qrCode %}
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        <h2 class="govuk-heading-m">QR code</h2>
        {{ appMarineLicenceSiteNoticeQrCode(qrCode) }}
      </div>
    </div>
  {% endif %}
{% endblock %}
