{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "radio-page/macro.njk" import appRadioPage %}

{% block beforeContent %}
{{ super() }}
<nav>
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
</nav>
{% endblock %}

{% block content %}

  {{ appRadioPage({
      name: "selectedAddress",
      errorSummary: errorSummary,
      errors: errors,
      heading: heading,
      isPageHeading: true,
      value: payload.selectedAddress,
      errorMessage: errors['selectedAddress'],
      projectName: projectName,
      items: items,
      csrfToken: csrfToken,
      buttonText: buttonText,
      cancelLink: cancelLink
      })
  }}

{% endblock %}
